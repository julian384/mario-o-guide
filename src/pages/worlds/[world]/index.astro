---
import Base from '../../../layouts/Base.astro';
import MoonRow from '../../../components/MoonRow.astro';
import SpoilerGate from '../../../components/SpoilerGate.astro';
import { WORLDS, PHASES, SPOILER_PHASES } from '../../../data/worlds.mjs';
import { allMoons, moonKey, tally, url } from '../../../lib/moons';

export function getStaticPaths() {
  return WORLDS.map((w) => ({ params: { world: w.id } }));
}

const { world } = Astro.params;
const w = WORLDS.find((x) => x.id === world)!;
const idx = WORLDS.indexOf(w);
const prev = WORLDS[idx - 1];
const next = WORLDS[idx + 1];
const moons = (await allMoons()).filter((m) => m.data.world === world);
const t = tally(moons);
const groups = PHASES.map((p) => ({ ...p, moons: moons.filter((m) => m.data.phase === p.id) })).filter((g) => g.moons.length);
const open = groups.filter((g) => !SPOILER_PHASES.includes(g.id));
const gated = groups.filter((g) => SPOILER_PHASES.includes(g.id));
const gatedCount = gated.reduce((n, g) => n + g.moons.length, 0);
const count = t.value === t.locations ? `${t.locations} moons` : `${t.locations} moon locations, worth ${t.value} moons`;
const written = moons.filter((m) => m.data.written).length;
const guides = written === moons.length ? 'Every moon has a full guide.' : written ? `Full guides for ${written} of ${moons.length} moons so far.` : 'Full guides are coming soon.';
const lede = [`${w.area}.`, `${count}.`, w.note, guides].filter(Boolean).join(' ');
---
<Base title={w.name} description={`All ${t.locations} Power Moons in the ${w.name} of Super Mario Odyssey, grouped by when they unlock.`} noindex>
  <section class="section">
    <span class="crumb"><a href={url('worlds/')}>Worlds</a> / {w.name}</span>
    <h1>{w.name}</h1>
    <p class="lede">{lede}</p>
    <div class="chips">
      {groups.map((g) => <a class={`chip phase ph-${g.id}`} href={`#${g.id}`}>{g.name} · {g.moons.length}</a>)}
    </div>
    <p class="progress-text" data-progress={moons.map(moonKey).join(',')}></p>
  </section>

  {open.map((g) => (
    <section class={`phase-block ph-${g.id}`} id={g.id}>
      <div class="phase-head">
        <span class="dot"></span>
        <h2>{g.name}</h2>
        <span class="muted">{g.moons.length} moons</span>
      </div>
      <p class="muted">{g.blurb}</p>
      <ul class="moon-list">{g.moons.map((m) => <MoonRow moon={m} />)}</ul>
    </section>
  ))}

  {gated.length > 0 && <SpoilerGate count={gatedCount} />}
  {gated.map((g) => (
    <section class={`phase-block ph-${g.id}`} id={g.id} data-spoiler hidden>
      <div class="phase-head">
        <span class="dot"></span>
        <h2>{g.name}</h2>
        <span class="muted">{g.moons.length} moons</span>
      </div>
      <p class="muted">{g.blurb}</p>
      <ul class="moon-list">{g.moons.map((m) => <MoonRow moon={m} />)}</ul>
    </section>
  ))}
  {gated.length > 0 && (
    <p data-spoiler hidden><button type="button" class="btn" data-spoiler-off>Hide post-game moons again</button></p>
  )}

  <nav class="pager" aria-label="Other worlds">
    <span>{prev && <a href={url(`worlds/${prev.id}/`)}>← {prev.name}</a>}</span>
    <span>{next && <a href={url(`worlds/${next.id}/`)}>{next.name} →</a>}</span>
  </nav>
</Base>
